<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <title>MuuMetrics</title>
    <link rel="stylesheet" href="/css/cowInfo.css" />
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700&display=swap" rel="stylesheet">
</head>

<body>

    <%- include("components/background") %>
    <%- include("components/header") %>

    <main class="content">

        <section class="left-panel">

            <h2 class="cow-id"><%= cowID %></h2>

                <table class="info-table">
                    <tr>
                        <td class="label">Índice de condición corporal</td>
                        <td class="value"><%= bcs %></td>
                    </tr>
                    <tr>
                        <td class="label">Estado coloquial</td>
                        <td class="value"><%= estado %></td>
                    </tr>
                    <tr>
                        <td class="label">Días en leche</td>
                        <td class="value"><%= diasLeche %></td>
                    </tr>
                </table>
            <div class="mini-graph">
                <img src="/images/catImage.jpg" class="graph-placeholder">
            </div>
        </section>

        <section class="health-meter">
            <h2 class="health-title">Salud-ometro</h2>

            <div class="circles-container">
                <% if (status === "rojo") { %>
                    <div class="circle-item">
                        <img src="/images/healthRed.png" class="health-circle" />
                        <p>Potencialmente <br> enferma</p>
                    </div>
                <% } %>
                
                <% if (status === "amarillo") { %>
                    <div class="circle-item">
                        <img src="/images/healthYellow.png" class="health-circle" />
                        <p>Propensa a <br> enfermedades</p>
                    </div>
                <% } %>
                
                <% if (status === "verde") { %>
                    <div class="circle-item">
                        <img src="/images/healthGreen.png" class="health-circle" />
                        <p>Saludable</p>
                    </div>
                <% } %>
            </div>

        </section>

    </main>

    <%- include("components/footer") %>

    <script src="/js/main.js"></script>
</body>
</html>