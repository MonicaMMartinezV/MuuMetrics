<script>
const frame = document.querySelector('.camera-frame');

function startFocus() {
    frame.classList.remove('rotating');
    frame.classList.add('focusing');
    setTimeout(() => {
    startRotate();
    }, 2500); // duration of focus animation
}

function startRotate() {
    frame.classList.remove('focusing');
    frame.classList.add('rotating');
    setTimeout(() => {
    startFocus();
    }, 1700); // duration of rotate animation
}



startFocus();

document.addEventListener("DOMContentLoaded", async () => {
    const url = "<%= redirectUrl %>";

    try {
        // Start loading the real page in the background
        const response = await fetch(url);

        // If the route returns HTML, get it
        const html = await response.text();
        
        // Insert the loaded HTML
        document.getElementById("content").innerHTML = html;

        // Hide loader and show REAL content
        document.getElementById("loader-wrapper").style.display = "none";
        document.getElementById("content").style.display = "block";

    } catch (err) {
        console.error("Failed to load info page:", err);
        // Worst case: fallback redirect  
        window.location.href = url;
    }
  });
</script>
<style>
  body, html {
    height: 100%;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #f0f0f0;
  }

  .camera-frame {
    width: 200px;
    height: 200px;
    max-width: 180px;
    max-height: 180px;
    min-width: 180px;
    min-height: 180px;
    position: relative;
    transform-origin: center;
    overflow: hidden;
  }

  /* Corner edges */
  .corner {
    width: 40px;
    height: 40px;
    border: 2px solid #000;
    position: absolute;
  }
  .corner.top-left { top: 0; left: 0; border-bottom: none; border-right: none; border-radius: 16px 0 0 0; --dx: -8px; --dy: -8px; }
  .corner.top-right { top: 0; right: 0; border-bottom: none; border-left: none; border-radius: 0 16px 0 0; --dx: 8px; --dy: -8px; }
  .corner.bottom-left { bottom: 0; left: 0; border-top: none; border-right: none; border-radius: 0 0 0 16px; --dx: -8px; --dy: 8px; }
  .corner.bottom-right { bottom: 0; right: 0; border-top: none; border-left: none; border-radius: 0 0 16px 0; --dx: 8px; --dy: 8px; }


  .center-svg {
    position: absolute;
    top: 50%;
    left: 43%;
    transform: translate(-50%, -50%);
    width: 90%;
    height: 90%;
    max-width: 100%;
    max-height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .center-svg svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    
    /*animation: breath 3s infinite ease-in-out;*/
  }

  .center-svg .snout { 
    transform: scale(0.28); 
    top: -14%;
    left: -6%;
    transform-origin: center;
    animation: circularMotion 0.5s infinite linear ;
    overflow: hidden;
 }


  .main {    
    position: relative;
    width: 200px;
    height: 200px;
  }
  /* Animations */
  .camera-frame.focusing .corner {
    animation: focus 0.9s ease-in-out forwards;
  }
  .camera-frame.rotating {
    animation: focusAndRotate 1.2s ease-in-out forwards;
  }

  @keyframes focus {
    0% { transform: scale(1) translate(0,0); opacity: 0.7; }
    50% { transform: scale(1.25) translate(var(--dx), var(--dy)); opacity: 1; }
    100% { transform: scale(1) translate(0,0); opacity: 0.7; }
  }

  @keyframes focusAndRotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(90deg); }
  }

  @keyframes circularMotion {
    0% { transform: translate(0, 0) scale(0.3); }
    12.5% { transform: translate(2px, 2px) scale(0.3); }
    25% { transform: translate(3px, 3px) scale(0.3); }
    37.5% { transform: translate(3px, 3.5px) scale(0.3); }
    50% { transform: translate(0, 6px) scale(0.3); }
    62.5% { transform: translate(-3px, 4px) scale(0.3); }
    75% { transform: translate(-3px, 3px) scale(0.3); }
    87.5% { transform: translate(-2px, 2px) scale(0.3); }
    100% { transform: translate(0, 0) scale(0.3); }
  }

  @keyframes breath {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
    
  }
</style>
