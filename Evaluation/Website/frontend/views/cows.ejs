<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Seleccionar vaca</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

    <header class="top-bar">
        <img src="/img/logoMuuMetricsWhite.png" class="logo1">
        <h1 class="title">
            <div class="m-wrapper">
                <img src="/img/mWhite.png" class="title-m">
            </div>
            uuMetrics
        </h1>
        <img src="/img/logoMuuMetricsWhite.png" class="logo2">
    </header>

    <main class="dropdown-container">

        <h2 class="select-title">Selecciona una vaca</h2>

        <select id="cowSelector" class="cow-dropdown">
            <option value="">-- Selecciona el ID de la vaca --</option>

            <% cows.forEach(cow => { %>
                <option value="<%= cow.IDCow %>"><%= cow.IDCow %></option>
            <% }) %>
        </select>

    </main>

    <script>
        document.getElementById("cowSelector").addEventListener("change", function() {
            const selectedId = this.value;
            if (selectedId) {
                window.location.href = `/cow/${selectedId}`;
            }
        });
    </script>

</body>
</html>